# Streamlit Secrets Configuration for Telecom ITSM RAG Chatbot
#
# On Streamlit Cloud: Copy these key-value pairs into Advanced Settings -> Secrets.
# On your local machine: Keep these in .streamlit/secrets.toml (Never commit secrets.toml to Git).

# DeepSeek API Key (used by deepseek-chat for grounded LLM answers)
DEEPSEEK_API_KEY = "sk-your-deepseek-api-key-here"

# OpenAI API Key (used by text-embedding-3-small for FAISS vector indexing)
OPENAI_API_KEY = "sk-your-openai-api-key-here"

# Optional Model Settings:
AI_BASE_URL = "https://api.deepseek.com"
AI_MODEL = "deepseek-chat"
